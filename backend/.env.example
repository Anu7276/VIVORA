# VIVORA Environment Configuration
# Copy this file to .env and fill in your API keys.

# ── Environment ────────────────────────────────────────────────────────────────
# "development" enables /docs, /openapi.json and the / info route.
# Any other value (production, staging) disables them.
ENV=production

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production (>= 32 chars; generate with: openssl rand -hex 32)
JWT_SECRET_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Model names (override per deployment) ─────────────────────────────────────
# gemini-1.5-flash is retired — use gemini-2.5-flash or later.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o-mini

# ── Per-task LLM routing ──────────────────────────────────────────────────────
# Each task picks a preferred provider: gemini | groq | openai | mock
# If the preferred provider has no API key, the router falls back automatically
# and logs a WARNING at startup naming the affected task.
#
# question_generation: runs ONCE at session start using RAG context (Gemini = richer)
QUESTION_GEN_PROVIDER=gemini
#
# live_turn: real-time follow-up questions and doubt answers (Groq = fast)
LIVE_PROVIDER=groq
#
# evaluation: score each spoken answer with rubric (Groq = fast per-answer)
EVALUATION_PROVIDER=groq
#
# report: final session analytics report (Gemini = richer summary)
REPORT_PROVIDER=gemini

# ── Voice Providers ───────────────────────────────────────────────────────────
# STT: browser | deepgram  (Whisper planned, not implemented)
# TTS: browser | elevenlabs
STT_PROVIDER=browser
TTS_PROVIDER=browser
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# When false (default in production), missing provider keys cause startup failure
ALLOW_STT_FALLBACK=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./vivora.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. DO NOT use * — it is rejected by
# browsers when allow_credentials=True and is a security vulnerability.
# BACKEND_CORS_ORIGINS=["http://localhost:3000","https://your-domain.com"]
