# VIVORA Environment Configuration
# Copy this file to .env and fill in your API keys.

# ── API Keys ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Per-task LLM routing ──────────────────────────────────────────────────────
# Each task picks a preferred provider: gemini | groq | openai | mock
# If the preferred provider has no API key, the router falls back automatically.
#
# question_generation: runs ONCE at session start using RAG context (Gemini = richer)
QUESTION_GEN_PROVIDER=gemini
#
# live_turn: real-time follow-up questions and doubt answers (Groq = fast)
LIVE_PROVIDER=groq
#
# evaluation: score each spoken answer with rubric (Groq = fast per-answer)
EVALUATION_PROVIDER=groq
#
# report: final session analytics report (Gemini = richer summary)
REPORT_PROVIDER=gemini

# ── Voice Providers ───────────────────────────────────────────────────────────
# STT: browser | deepgram  (Whisper and EdgeTTS planned)
# TTS: browser | elevenlabs
STT_PROVIDER=browser
TTS_PROVIDER=browser
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# When false (default in production), missing provider keys cause startup failure
ALLOW_STT_FALLBACK=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./vivora.db
